     7 5.30340,4.81742,4.34700,3.92820,3.56900,3.21600,2.94817,2.81219,
     8 2.77393,2.66248,2.56270,2.47274,2.38790,2.25341,2.24256,2.18020,
     9 2.07051,2.07356,2.02859,1.98890,1.90182,1.83262,1.77333,1.72029,
     1 1.67191,1.37113,1.59279,1.51293,0.461100,0.545000,0.655150,
     2 0.690200,0.704000,0.700999,0.685870,0.663100,0.646453,0.616341,
     3 0.589092,0.563359,0.547751,0.529300/
C
      DATA BLT/0.262003,0.630900,0.750800,1.12780,1.33260,1.02000,
     1 3.13220,2.28680,2.64120,3.11250,3.17360,2.17350,1.90020,
     2 3.13220,4.17910,5.20340,7.19640,6.77230,7.43980,7.38730,
     3 7.36790,7.35580,7.35110,7.35370,7.35730,7.35730,7.34090,
     4 7.29200,7.16760,7.03180,6.70060,6.37470,6.07010,5.81960,
     5 5.23380,6.72860,9.64350,9.81840,10.2946,10.9480,12.0144,
