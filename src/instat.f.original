      PROGRAM INSTAT
      IMPLICIT DOUBLE PRECISION(A-H,O-Z) 
C
C      THIS PROGRAM CONSISTS OF TWO PARTS.
C      THE FIRST PART CONSTRUCTS THE WILSON PLOT FROM THE OBSERVED
C      INTENSITIES, SOLVES THE LEAST-SQUARES PROBLEM FOR THE OVERALL
C      SCALE FACTOR AND THE OVERALL ISOTROPIC DISPLACEMENT PARAMETER
C      AND COMPUTES THE MAGNITUDES OF THE NORMALIZED STRUCTURE FACTORS
C      FOR GENERAL REFLECTIONS. FINALLY A HISTOGRAM OF |E| VALUES IS
C      PREPARED, FOR COMPARISON WITH THE PDFS COMPUTED IN THE SECOND
C      PART.
C      THE SECOND PART PRODUCES IDEAL AND NON-IDEAL PDFS OF |E|, THE
C      LATTER DEPENDING ON THE ATOMIC COMPOSITION OF THE ASYMMETRIC
C      UNIT AND SPACE-GROUP SYMMETRY. THE PROGRAM TREATS ALL THE
C      SYMMETRIES OF THE TRICLINIC, MONOCLINIC AND ORTHORHOMBIC SYSTEMS
C      INCLUDING FDD2 AND FDDD
C
C      INPUT TO THE PROGRAM:
C      
C      (1) DESCRIPTION OF THE CALCULATION                FORMAT(80A1)
C
C      (2) DIRECT CELL PARAMETERS: A, B, C IN ANGSTROM UNITS, ALPHA,
C          BETA, GAMMA IN DEGREES                         FREE FORMAT
C
C      (3)  NUMBER OF ATOMIC TYPES: NAT                   FREE FORMAT
C
C      (4) ASYMMETRIC UNIT CONTENT: NAT LINES, WITH ATOM(I) and N(I)
C          IN EACH, WHERE ATOM(I) IS AN UP TO 2-CHARACTER ATOMIC SYMBOL
C          AND N(I) IS THE NUMBER OF ATOMS OF TYPE I IN THE ASYM. UNIT.
C                                                         FREE FORMAT
C      (5) NUMBER OF ASYM> UNITS IN THE UNIT CELL: NUNIT  FREE FORMAT
C
C      (6) 'STRUCTURE FACTORS' CIF FILE OF STRUCTURE:
C          ACTA-COEDITOR-CODE-SUP2.HKL                    FREE FORMAT                                                     .
C          (e.g. if the coeditor code is hb5427, the file is:
C           hb5427-sup2.hkl) 
C
C      (7) ISPG,ISER(1),ISER(2),JSYM,NCOEF,NBESK,ILATT
C
C          WHERE:
C
C      *   ISPG IS THE NUMBER OF THE POINT GROUP ASSUMED:   FREE FORMAT
C          (SEE TABLE BELOW)
C          THIS NUMBER SERVES THE COMPUTATION OF NORMALIZED STRUCTURE 
C          FACTORS (ORDER OF THE ISOTROPY SUBGROUP - EPS)
C
C
C      *   ISER(1) - SERIAL NUMBER OF THE FIRST SPACE GROUP  FREE FORMAT
C
C      *   ISER(2) - SERIAL NUMBER OF THE SECOND SPACE GROUP FREE FORMAT                                BUTIONS ARE REQUESTED. 
C
C          IF BOTH ISER(1) AND ISER(2) ARE IN THE RANGE, THE TWO SPACE 
C          GROUPS WILL BE COMPARED. IF ONLY ONE EXACT PDF HAS TO BE 
C          COMPARED WITH THE HISTOGRAM, ISER(1) WILL BE THE SPACE GROUP
C          NUMBER, AND ISER(2)=0. ONLY THEN JSYM (BELOW)  IS RELEVANT.
C
C      *   JSYM      EQUALS 9 IF IRRELEVANT.JSYM=0 IF ISER(1)
C                    POINTS TO A NONCENTROSYMMETRIC, JSYM=1
C                    IF ISER(1) POINTS TO A CENTROSYMMETRIC
C                    SPACE GROUP.
C
C     
C      *    NCOEF     NUMBER OF THE COEFFICIENTS TO BE USED
C                     IN THE SUMMATION OF A SINGLE FOURIER OR
C                     FOURIER-BESSEL SERIES. USUALLY: NCOEF=40.
C
C      *    NBESK     NUMBER OF TERMS IN A SERIES OF BESSEL
C                     FUNCTIONS (ORTHORHOMBIC ONLY). USUALLY:
C                     NBESK=20.
C
C      *    ILATT     LATTICE MULTIPLICITY (1, 2 or 4)
C
C     THE PROGRAM EXPECTS THE INPUT TO BE ON UNIT 5 NAMED 'STIN'.THE
C     'STRUCTURE FACTORS' CIF FILE, AS DECRIBED ABOVE, IS EXPECTED TO
C     BE ON UNIT 20, NAMED 'CIFF'
C     -------------------------------------------------------------------
C     THE POINT GROUP NUMBERS FOR ISPG ARE RELATED TO THE POINT GROUPS
C     AS FOLLOWS:
C
C     1 - 1      2 -  -1    3 - 2      4 - M      5 - 2/M    6 - 222
C     7 - MM2    8 - MMM
C     ------------------------------------------------------------------
C     THE SPACE GROUP NUMBERS FOR ISER ARE RELATED TO THE SPACE GROUPS 
C     AS FOLLOWS: 
C 
C     1 - P1     2 - P -1   3 - P2     4 - C2     5 - P2/M   6 - C2/M   
C     7 - P222   8 - C222    9 - F222  10 - PMM2  11 - CMM2  12 - FMM2
C    13 - FDD2B 14 - PMMM   15 - CMMM  16 - FMMM  17 - FDDDB 
C          
C     TWO-FOLD SCREW AXES AND GLIDE PLANES (APART FROM D) ARE DISREGARDED
C     IN THESE SYMMETRIES. E.G., IF PNA2(1) AND PNAM ARE TO BE RESOLVED,
C     THE NUMBERS TO BE ASSIGNED TO ISER(1) AND ISER(2) ARE 10 AND 14.
C
C--------------------------------------------------------------------------
C
      CHARACTER*1 TITLE(80),SYMBOL1(10),SYMBOL2(10),IBL,S1,S2
      CHARACTER*2 NAMS(10),ATOM(10)                                                 -
      CHARACTER*3 IND,XXX
      CHARACTER*4 STIN,SOUT,FFIL,EFIL,INST
      CHARACTER*5 SPG1,SPG2,SP
      CHARACTER*6 FSTLSQ
      CHARACTER*15 CIFF
C
      COMMON/SF/F(92),AL(10),AS(10),BL(10),BS(10),CL(10),CS(10),DL(10),
     $DS(10),EL(10),NO(10),NAT,ILATT,ISPG
      COMMON/CELL/ N(10),C(6),GD(3,3),R(6),GR(3,3)
      COMMON/ITL/TITLE
      COMMON/SHELL/STLSQLB(30),STLSQUB(30),STLSQMAX,NWIL,IJ,DEL,NREF
      COMMON/RWTEX/ISER(2),JSYM,NCOEF,NBESK
C
      DATA STIN,SOUT,FFIL,FSTLSQ,EFIL,INST/'STIN','SOUT','FFIL',
     $'FSTLSQ','EFIL','INST'/
C 
      OPEN(5,FILE=STIN)
      OPEN(6,FILE=SOUT)
      OPEN(12,FILE=FFIL)
      OPEN(14,FILE=FSTLSQ)
      OPEN(15,FILE=EFIL)
CC
      READ(5,10)TITLE
      WRITE(6,10)TITLE
10    FORMAT(80A1)
C
      READ(5,*)C
      WRITE(6,20)C(1),C(2),C(3),C(4),C(5),C(6)
20    FORMAT(5X,'DIRECT CELL DIMENSIONS'/5X,
     $'A = ',F9.5,' B = ',F9.5,' C = ',F9.5,/5X,
     $'ALPHA = ',F9.5,' BETA = ',F9.5,' GAMMA = ',F9.5)
C
C     DEGREES TO RADIANS CONVERSION:
C
      U=3.14159265/180.
      DO 222 I=4,6
222   C(I)=C(I)*U
C
      CALL METRIC(C,GD)
      CALL INVERSE(GD,GR)
      CALL RECIP(GR,R)
C
C--------------------------------------------------------------
C     COMPOSITION OF THE UNIT CELL, SCATTERING FACTOR CONSTANTS 
C     AND ATOMIC NUMBERS
C--------------------------------------------------------------
      READ(5,*)NAT
      WRITE(6,30)NAT
30    FORMAT(/5X,'THE NUMBER OF ATOMIC TYPES IS:',I2)
C
      WRITE(6,300)
300   FORMAT(/5X,'THE ASYMMETRIC UNIT CONTENT IS:'/)
      DO 31 I=1,NAT
      READ(5,*)ATOM(I),N(I)
32    FORMAT(6X,A2,1X,I2)
      WRITE(6,32)ATOM(I),N(I)
31    CONTINUE
C
C     GET 9-TERM ANALYTICAL APPROXIMATION OF THE SCATTERING FACTORS
C
      CALL SCAFA(ATOM)
C
      READ(5,*)NUNIT
      WRITE(6,33)NUNIT
33    FORMAT(/5X,'THE NUMBER OF ASYMMETRIC UNITS IS:',I3)
C
      DO 75 I=1,NAT
75    N(I)=N(I)*NUNIT
C
      DO 7 I = 1,NAT
7     NO(I) = INT(AL(I)+BL(I)+CL(I)+DL(I)+EL(I)+0.5)
C
      WRITE(6,8)(ATOM(I),N(I),NO(I),I=1,NAT)
8     FORMAT(/5X,'ATOM','  NUMBER IN UNIT CELL','  ATOMIC NUMBER'/
     $(5X,A2,9X,I3,17X,I2))
C
C--------------------------------------------------------
C     READ 'STRUCTURE FACTOR' DATA FILE AND WRITE H,K,L,FOBS**2 FILE
C     PRECEDED BY TITLE. SET ALL NEGATIVE INTENSITIES TO ZERO..
C-------------------------------------------------------------------
C
      WRITE (6,700)
700   FORMAT(/5X,'ATOMIC NUMBERS ARE COMPUTED FROM SCATTERING FACTOR',
     $' PARAMETERS')
      READ(5,*)CIFF
      WRITE(6,200)CIFF
200   FORMAT(/5X,'THE NAME OF THE HKL F FILE IS: ',A15)
C
     
      READ(5,*)ISPG,(ISER(K),K=1,2),JSYM,NCOEF,NBESK,ILATT
      WRITE(6,104)ISPG
104   FORMAT(5x,'THE POINT GROUP NUMBER IS :',I3)
      WRITE(6,105)(ISER(K),K=1,2),JSYM,NCOEF,NBESK,ILATT
105   FORMAT(5X,'ISER :',I2,1X,I2,' JSYM :',I2,' NCOEF :',I3,' NBESK :',
     $I3,' ILATT :',i2)
C
      CALL FSQDATA(CIFF)
C
C-------------------------------------------------------------------
C     PREPARE SHELLS FOR WILSON PLOT
C-------------------------------------------------------------------
C
      CALL SHELLS(HDHMAX)     
C
C------------------------------------------------------------------
C     CONSTRUCT THE WILSON PLOT, GET SCALE AND B FACTORS
C------------------------------------------------------------------
C
      CALL WPLOT(SCALE,BFAC)
C
C------------------------------------------------------------------
C     GET |E| VALUES FOR GENERAL REFLECTIONS AND THE |E| HISTOGRAM
C------------------------------------------------------------------
C 
      CALL EVALUES(SCALE,BFAC)
C
C------------------------------------------------------------------
C     SPACE-GROUP DATA STATEMENTS FOR THE SECOND PART
C-----------------------------------------------------------------
C
      CALL SPGRCOMP(ATOM)
C
C------------------------------------------------------------------
C     NON-IDEAL PDFS VS |E| HISTOGRAM
C------------------------------------------------------------------
C
      CALL RWPDF
C
      END
C
C     GET DIRECT METRIC TENSOR
C
      SUBROUTINE METRIC(C,G)
      IMPLICIT DOUBLE PRECISION(A-H,O-Z)
      DIMENSION C(6),G(3,3)
      DO 1 I = 1,3
1     G(I,I) = C(I)**2
      G(2,3) = C(2)*C(3)*COS(C(4))
      G(3,2) = G(2,3)
      G(3,1) = C(3)*C(1)*COS(C(5))
      G(1,3) = G(3,1)
      G(1,2) = C(1)*C(2)*COS(C(6))
      G(2,1) = G(1,2)
      RETURN
      END
C
C     GET RECIPROCAL METRIC TENSOR
C
      SUBROUTINE INVERSE (A,B)
      IMPLICIT DOUBLE PRECISION(A-H,O-Z)
      DIMENSION A(3,3), B(3,3)
      B(1,1) = A(2,2)*A(3,3)-A(3,2)*A(2,3)
      B(2,1) = A(2,1)*A(3,3)-A(3,1)*A(2,3)
      B(3,1) = A(2,1)*A(3,2)-A(3,1)*A(2,2)
      DET = A(1,1)*B(1,1)-A(1,2)*B(2,1)+A(1,3)*B(3,1)
      IF (DET) 10,30,10
   10 B(1,2) = A(1,2)*A(3,3)-A(3,2)*A(1,3)
      B(2,2) = A(1,1)*A(3,3)-A(3,1)*A(1,3)
      B(3,2) = A(1,1)*A(3,2)-A(3,1)*A(1,2)
      B(1,3) = A(1,2)*A(2,3)-A(2,2)*A(1,3)
      B(2,3) = A(1,1)*A(2,3)-A(2,1)*A(1,3)
      B(3,3) = A(1,1)*A(2,2)-A(2,1)*A(1,2)
      DO 20 I = 1,3
      DO 20 J = 1,3
   20 B(I,J) = (-1.)**(I+J)*B(I,J)/DET
      RETURN
   30 WRITE(6,*)'THE TRANSFORMATION MATRIX IS SINGULAR. STOP'
      STOP
      END
C
C     RETRIEVE RECIPROCAL UNIT-CELL PARAMETRS
C
      SUBROUTINE RECIP(GR,CR)
      IMPLICIT DOUBLE PRECISION(A-H,O-Z)
      DIMENSION GR(3,3),CR(6)
      DO 1 I = 1,3
1     CR(I) = DSQRT(GR(I,I))
      CR(4) = GR(2,3)/(CR(2)*CR(3))
      CR(5) = GR(3,1)/(CR(3)*CR(1))
      CR(6) = GR(1,2)/(CR(1)*CR(2))
      RETURN
      END
C
C     SCATTERING FACTOR CONSTANTS FOR THE ATOMS INPUT
C
      SUBROUTINE SCAFA(NAMS)
      IMPLICIT DOUBLE PRECISION(A-H,O-Z)
      CHARACTER*2 NAM(92),NAMS(10)
      COMMON/SF/F(92),AL(10),AS(10),BL(10),BS(10),CL(10),CS(10),DL(10),
     $DS(10),EL(10),NO(10),NAT,ILATT,ISPG
      DIMENSION ALT(92),AST(92),BLT(92),BST(92),CLT(92),CST(92),DLT(92)
      DIMENSION DST(92),ELT(92)
      DATA NAM/'H ','HE','LI','BE','B ','C ','N ','O ','F ','NE',
     $ 'NA','MG','AL','SI','P ','S ','CL','AR','K ','CA','SC',
     $ 'TI','V ','CR','MN','FE','CO','NI','CU','ZN','GA','GE',
     $ 'AS','SE','BR','KR','RB','SR','Y ','ZR','NB','MO','TC',
     $ 'RU','RH','PD','AG','CD','IN','SN','SB','TE','I ','XE',
     $ 'CS','BA','LA','CE','PR','ND','PM','SM','EU','GD','TB',
     $ 'DY','HO','ER','TM','YB','LU','HF','TA','W ','RE','OS',
     $ 'IR','PT','AU','HG','TL','PB','BI','PO','AT','RN','FR',
     $ 'RA','AC','TH','PA','U '/  
C
      DATA ALT/0.489918,0.873400,1.12820,1.59190,2.05450,2.31000,
     1 12.2126,3.04850,3.53920,3.95530,4.76260,5.42040,6.42020,6.29150,
     2 6.43450,6.90530,11.4604,7.48450,8.21860,8.62660,9.18900,9.75950,
     3 10.2971,10.6406,11.2819,11.7695,12.2841,12.8376,13.3380,14.0743,
