     5 17.7760,17.8765,17.6142,3.70250,19.1301,19.2674,19.2957,19.3319,
     6 19.2808,19.2214,19.1624,19.1889,19.6418,19.9644,20.1472,20.2933,
     7 20.3892,20.3361,20.5780,21.1671,22.0440,22.6845,23.3405,24.0042,
     8 24.6274,25.0709,25.8976,26.5070,26.9049,27.6563,28.1819,28.6641,
     9 28.9476,29.1440,29.2024,29.0818,28.7621,28.1894,27.3049,27.0059,
     1 16.8819,20.6809,27.5446,31.0617,33.3689,34.6726,35.3163,35.5631,
     2 35.9299,35.7630,35.6597,35.5645,35.8847,36.0228/
C
      DATA AST/20.6593,9.10370,3.95460,43.6427,23.2185,20.8439,
